    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "htmlparser2": "^12.0.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "parse-ingredient": "^3.0.0",
    "posthog-js": "^1.435.3",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "serwist": "^9.5.12",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
