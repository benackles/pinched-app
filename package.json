{
  "name": "pinched-app",
  "version": "0.1.0",
  "private": true,
  "description": "Pinched \u2014 plan the week, shop for the gap, prep once, cook faster.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "PINCHED_LOCAL=1 next dev",
