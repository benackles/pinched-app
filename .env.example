# Pinched — environment variables.
#
# Copy to .env.local and fill in what you need. Nothing here is required to TRY the app: run
# `pnpm dev:local` and it works with no credentials at all (see "Local demo mode" at the bottom).
# Variables prefixed NEXT_PUBLIC_ are sent to the browser — never put a secret in one.

# ─────────────────────────────── App ───────────────────────────────
# Where the app is served. Used for Stripe return links and to decide where the service worker
# may register (it only registers on this host, and never on Vercel preview deployments).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────── Clerk (accounts) ───────────────────────────────
# Dashboard → API keys. Enable Email + Google under User & authentication.
# Also: Dashboard → Integrations → Supabase (activates the Supabase-compatible session token).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Dashboard → Webhooks → endpoint https://<your-domain>/api/webhooks/clerk
# Events: user.created, user.updated, user.deleted. (user.deleted removes all of that person's data.)
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# ─────────────────────────────── Supabase (data) ───────────────────────────────
# Project settings → API. Also add Clerk under Authentication → Third-Party Auth.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# The anon key, or the newer publishable key — either works; it is safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY. Bypasses Row Level Security; used by webhooks and jobs, never on behalf of a request's
# user. (SUPABASE_SECRET_KEY is accepted as an alias.)
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────── Stripe (Pinched Pro) ───────────────────────────────
# Create two recurring prices on one product: $5.99 / month and $39 / year.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...
# Developers → Webhooks → endpoint https://<your-domain>/api/webhooks/stripe
# Events: checkout.session.completed, customer.subscription.created, customer.subscription.updated,
#         customer.subscription.deleted, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_...
# Also set up the Customer Portal (Settings → Billing → Customer portal) so "Manage plan" works.

# ─────────────────────────────── Push reminders (optional) ───────────────────────────────
# `pnpm vapid:keys` prints a pair. The PUBLIC key goes here (and in the Edge Function's secrets);
# the private key is only ever a Supabase function secret. See supabase/functions/send-reminders.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─────────────────────────────── Analytics (optional) ───────────────────────────────
# Server-side only (no cookies, no client SDK). Leave empty to turn analytics off entirely.
# Anonymous events keyed by an opaque user id; skipped for Global Privacy Control / Do Not Track.
POSTHOG_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com

# ─────────────────────────────── Local demo mode ───────────────────────────────
# `pnpm dev:local` (= PINCHED_LOCAL=1 next dev) runs the whole app with no accounts and no cloud:
# a real Postgres (PGlite) with the real migrations and Row Level Security, sign-in with any email,
# files on disk, and a "Try Pro locally" switch instead of Stripe. It is refused when Clerk keys are
# set or when running on Vercel, so it can never be switched on in a real deployment.
# PINCHED_LOCAL=1
# Where local mode keeps its database and uploads (default ./.pinched-local, git-ignored).
# PINCHED_LOCAL_DIR=
# PINCHED_LOCAL_DB=memory      # keep everything in memory (tests)

# Service worker on a local production build (`pnpm build:e2e`), for testing the installed app:
# NEXT_PUBLIC_PWA_ALLOW_LOCALHOST=1
# URL import refuses private/loopback addresses; the end-to-end tests serve a recipe from localhost:
# PINCHED_IMPORT_ALLOW_PRIVATE=1
